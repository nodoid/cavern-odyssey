<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SuperSqij</AssemblyName>
    <RootNamespace>SuperSqij</RootNamespace>
    <DefineConstants>$(DefineConstants);WINDOWS;DESKTOP</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationTitle>Super Sqij</ApplicationTitle>
    <ApplicationId>uk.co.allthejohnsons.supersqij</ApplicationId>
    <WindowsPackageName>49556nodoid.SuperSqij</WindowsPackageName>
    <PublisherDisplayName>all-the-johnsons</PublisherDisplayName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\SuperSqij.Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\SuperSqij.Shared\Assets\*.png">
      <LogicalName>SuperSqij.Assets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.6.1" />
  </ItemGroup>
</Project>
